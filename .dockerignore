# Build provenance resolves HEAD from a minimal Git view. Keep repository
# configuration, history, logs, hooks, and index out of the Docker context.
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs/
!.git/refs/**
.gitignore
.pi/
.DS_Store
.venv/
venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
cache/
local/
logs/
transfer/
backups/
runs/
hf_cache/
tests/
db/
matching_pipeline/metadata_extraction/descriptions*.jsonl
matching_pipeline/metadata_matching/similarity_functions/artist/common_artists.csv
scrapers/lostart/data/
scrapers/sothebys/data/
