# Safe local/development defaults. Copy to a protected override for production.
POSTGRES_DB=smartmatch_production
POSTGRES_USER=smartmatch
POSTGRES_PASSWORD=smartmatch
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_HOST=db
POSTGRES_PORT=5432

SMARTMATCH_IMAGES_DIR=/app/db/images
CACHE_DIR=/app/cache

# Unified application logging. ALL includes DEBUG; ERROR emits only errors.
SMARTMATCH_LOG_LEVEL=ERROR
SMARTMATCH_LOG_RETENTION_DAYS=30
SMARTMATCH_LOG_DIR=/app/logs

# DINOv3 access is gated. Supply a token with access to the selected model.
HF_TOKEN=
DINOV3_MODEL_ID=facebook/dinov3-vith16plus-pretrain-lvd1689m
ALLOW_NON_GPU_INFERENCE=0
MATCHING_BATCH_SIZE=10
# MATCHING_WRITE_OUTPUT_CSV=1

# GPU metadata defaults used by the base Compose stack.
VLLM_USE_FLASHINFER_SAMPLER=0
METADATA_BACKEND=vllm
METADATA_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
METADATA_QUANTIZATION=awq_marlin
METADATA_DEVICE=cuda

SCRAPER_REQUEST_COOLDOWN_SECONDS=5
SCRAPER_INTERVAL=1d

SMARTMATCH_MATCH_EXPIRATION_AGE=30d

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=80
FRONTEND_DEBUG=0
