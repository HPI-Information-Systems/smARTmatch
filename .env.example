# Safe local/development defaults. Copy to a protected override for production.
POSTGRES_DB=smartmatch_production
POSTGRES_USER=smartmatch
POSTGRES_PASSWORD=smartmatch
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_HOST=db
POSTGRES_PORT=5432

SMARTMATCH_IMAGES_DIR=/app/db/images
CACHE_DIR=/app/cache

# Unified application logging. ALL includes DEBUG; ERROR emits only errors.
SMARTMATCH_LOG_LEVEL=ALL
SMARTMATCH_LOG_RETENTION_DAYS=30
SMARTMATCH_LOG_DIR=/app/logs

# DINOv3 access is gated. Supply a token with access to the selected model.
HF_TOKEN=
DINOV3_MODEL_ID=facebook/dinov3-vith16plus-pretrain-lvd1689m
ALLOW_NON_GPU_INFERENCE=0
MATCHING_BATCH_SIZE=10
# MATCHING_WRITE_OUTPUT_CSV=1

# GPU metadata defaults used by the base Compose stack.
VLLM_USE_FLASHINFER_SAMPLER=0
METADATA_BACKEND=vllm
METADATA_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
METADATA_QUANTIZATION=awq_marlin
METADATA_DEVICE=cuda
METADATA_GPU_MEMORY_UTILIZATION=0.55
METADATA_MAX_NUM_SEQS=4

SCRAPER_REQUEST_COOLDOWN_SECONDS=5
SCRAPER_INTERVAL=1d

SMARTMATCH_MATCH_EXPIRATION_AGE=30d

# Optional startup and UTC-daily telemetry inventories the complete historical match graph.
# The seven-day window applies only to recent summary counts; the receiver may
# request full rows for any missing or stale historical match.
TELEMETRY_ENABLED=false
# Remote endpoints must use https://smartmatch.leogruetzner.com/*.
# Local/private Docker endpoints remain available for isolated testing.
TELEMETRY_ENDPOINT=
# Shared static bearer token; use a long random secret and configure the same
# value as TELEMETRY_RECEIVER_AUTH_TOKEN on the receiver.
TELEMETRY_AUTH_TOKEN=
# Test-only authorization for loopback, private-IP, and local Docker DNS hosts;
# it also permits HTTP for those hosts.
TELEMETRY_ALLOW_INSECURE_LOCAL_HTTP=false
TELEMETRY_TIMEOUT_SECONDS=30
# Random pacing after successful pages reduces sustained proxy request bursts.
TELEMETRY_PAGE_DELAY_MIN_SECONDS=0.25
TELEMETRY_PAGE_DELAY_MAX_SECONDS=0.5

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=80
FRONTEND_DEBUG=0
